# 易换校园 环境变量示例
# 复制为 .env 并填写真实值。.env 不入 Git。

# 服务端口
PORT=3000

# 会话密钥（生产请用随机长字符串）
SESSION_SECRET=change-me-to-a-long-random-string

# 上传图片最大字节数（默认 3MB）
UPLOAD_MAX_BYTES=3145728

# AI 大模型配置（OpenAI 兼容 Chat Completions tools 协议）
# 留空则进入"离线演示模式：未接入真实大模型"
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# AI 请求超时毫秒（默认 30s）
AI_TIMEOUT_MS=30000

# AI tools 循环最大轮数（默认 5）
AI_MAX_ROUNDS=5

# 单条消息最大字符数
AI_MAX_MESSAGE_CHARS=2000

# 历史消息保留条数
AI_MAX_HISTORY=20

# 每用户每分钟 AI 请求数
AI_RATE_LIMIT_PER_MIN=20